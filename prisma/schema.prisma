generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  SUPERVISOR
  LIDER
  INSPECTOR
  RESIDENTE
  CLIENTE
}

model Usuario {
  id              String   @id @default(cuid())
  nombre          String
  usuario         String   @unique // login, minúsculas normalizadas
  passwordHash    String
  rol             Rol
  clienteNombre   String? // para rol CLIENTE: debe coincidir con Inspeccion.cliente
  plantaResidente String? // para rol RESIDENTE: planta donde está asignado
  activo          Boolean  @default(true)
  creadoEn        DateTime @default(now())

  capturas             Captura[]
  estado               EstadoInspector?
  inspeccionesAsig     InspeccionInspector[]
  mensajesChat         MensajeChat[]
  solicitudesApoyo     SolicitudApoyo[]      @relation("SolicitudApoyoUsuario")
  solicitudesAtendidas SolicitudApoyo[]      @relation("SolicitudApoyoAtendidaPor")
  notasResidente       NotaResidente[]       @relation("NotaResidenteResidente")
  notasComoAutor       NotaResidente[]       @relation("NotaResidenteAutor")
}

// bitácora de seguimiento del personal Residente (asignado de forma fija a
// la planta de un cliente): notas que deja liderazgo al dar seguimiento
model NotaResidente {
  id          String   @id @default(cuid())
  residente   Usuario  @relation("NotaResidenteResidente", fields: [residenteId], references: [id], onDelete: Cascade)
  residenteId String
  autor       Usuario  @relation("NotaResidenteAutor", fields: [autorId], references: [id])
  autorId     String
  contenido   String
  creadoEn    DateTime @default(now())

  @@index([residenteId, creadoEn])
}

model Inspeccion {
  id                  String    @id @default(cuid())
  nombre              String
  numeroParte         String?
  cliente             String?
  planta              String?
  meta                Int       @default(0)
  precioPorPieza      Float     @default(0)
  fechaEntrega        DateTime?
  instrucciones       String?
  instruccionesPdfUrl String?
  piezasBuenas        Int       @default(0)
  piezasMalas         Int       @default(0)
  cerrado             Boolean   @default(false)
  cerradoPor          String?
  cerradoEn           DateTime?
  creadoEn            DateTime  @default(now())

  capturas         Captura[]
  defectos         DefectoResumen[]
  inspectores      InspeccionInspector[]
  solicitudesApoyo SolicitudApoyo[]

  @@index([cliente])
  @@index([cerrado])
}

// tabla puente: qué inspectores están asignados a qué inspección
model InspeccionInspector {
  id           String     @id @default(cuid())
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspeccionId String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  usuarioId    String

  @@unique([inspeccionId, usuarioId])
  @@index([usuarioId])
}

model Captura {
  id           String     @id @default(cuid())
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspeccionId String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  usuarioId    String
  buenas       Int        @default(0)
  malas        Int        @default(0)
  defecto      String?
  fotoUrl      String?
  creadoEn     DateTime   @default(now())

  @@index([inspeccionId, creadoEn])
  @@index([usuarioId])
}

// contador acumulado por tipo de defecto (para el Pareto sin recalcular todo)
model DefectoResumen {
  id           String     @id @default(cuid())
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspeccionId String
  tipo         String
  cantidad     Int        @default(0)

  @@unique([inspeccionId, tipo])
}

model EstadoInspector {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String   @unique
  estado    String // activo | material | comida | bano | descanso
  estacion  String? // puesto físico de trabajo (Estación 1, 2, ...), elegido al iniciar turno
  desde     DateTime @default(now())
}

// chat grupal de liderazgo: Admin, Supervisor y Líder
model MensajeChat {
  id        String   @id @default(cuid())
  autor     Usuario  @relation(fields: [autorId], references: [id])
  autorId   String
  contenido String
  creadoEn  DateTime @default(now())

  @@index([creadoEn])
}

// llamado de un inspector pidiendo apoyo de un Líder/Supervisor en su estación
model SolicitudApoyo {
  id            String      @id @default(cuid())
  usuario       Usuario     @relation("SolicitudApoyoUsuario", fields: [usuarioId], references: [id])
  usuarioId     String
  estacion      String?
  inspeccion    Inspeccion? @relation(fields: [inspeccionId], references: [id])
  inspeccionId  String?
  atendida      Boolean     @default(false)
  atendidaPor   Usuario?    @relation("SolicitudApoyoAtendidaPor", fields: [atendidaPorId], references: [id])
  atendidaPorId String?
  atendidaEn    DateTime?
  creadoEn      DateTime    @default(now())

  @@index([atendida])
}
