generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  SUPERVISOR
  GERENTE
  LIDER
  INSPECTOR
  RESIDENTE
  CLIENTE
}

// Cada empresa de sorteo que usa la plataforma (multi-empresa / SaaS). Todo lo
// demás cuelga de ella: sus usuarios, inspecciones, clientes y criterios.
// El resto de las tablas se aísla a través de esas relaciones (ver lib/tenant.ts).
model Organizacion {
  id          String   @id @default(cuid())
  nombre      String // razón social: sale en reportes, PDF y páginas públicas
  nombreCorto String // marca corta (ej. SDB)
  activa      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  usuarios     Usuario[]
  inspecciones Inspeccion[]
  empresas     Empresa[]
  criterios    CriterioParte[]
  bitacora     BitacoraCambio[]
}

// empresas cliente dadas de alta por un Admin; los usuarios con rol CLIENTE
// solo pueden asignarse a una empresa ya registrada aquí
model Empresa {
  id             String       @id @default(cuid())
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  organizacionId String
  nombre         String
  activa         Boolean      @default(true)
  creadoEn       DateTime     @default(now())

  @@unique([organizacionId, nombre])
}

model Usuario {
  id              String       @id @default(cuid())
  organizacion    Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  organizacionId  String
  // dueño de la plataforma: da de alta y administra organizaciones
  superadmin      Boolean      @default(false)
  nombre          String
  usuario         String       @unique // login, minúsculas normalizadas
  passwordHash    String
  rol             Rol
  clienteNombre   String? // para rol CLIENTE: debe coincidir con Inspeccion.cliente
  plantaResidente String? // para rol RESIDENTE: planta donde está asignado
  activo          Boolean      @default(true)
  creadoEn        DateTime     @default(now())

  capturas             Captura[]
  estado               EstadoInspector?
  inspeccionesAsig     InspeccionInspector[]
  mensajesChat         MensajeChat[]
  solicitudesApoyo     SolicitudApoyo[]      @relation("SolicitudApoyoUsuario")
  solicitudesAtendidas SolicitudApoyo[]      @relation("SolicitudApoyoAtendidaPor")
  notasResidente       NotaResidente[]       @relation("NotaResidenteResidente")
  notasComoAutor       NotaResidente[]       @relation("NotaResidenteAutor")
  notificaciones       Notificacion[]
  suscripcionesPush    SuscripcionPush[]
  relevosEntregados    RelevoTurno[]         @relation("RelevoAutor")
  enlacesCreados       EnlaceCompartido[]
  reportes8D           Reporte8D[]
  solicitudesServicio  SolicitudServicio[]   @relation("SolicitudServicioSolicitante")
  solicitudesResueltas SolicitudServicio[]   @relation("SolicitudServicioAtendida")
  asistencias          RegistroAsistencia[]
  certificaciones      Certificacion[]       @relation("CertificacionInspector")
  certificacionesDadas Certificacion[]       @relation("CertificacionOtorgante")
  plantillasChecklist  PlantillaChecklist[]
  auditorias           Auditoria[]
  etiquetasLiberacion  EtiquetaLiberacion[]
  relevosRecibidos     RelevoTurno[]         @relation("RelevoReceptor")
}

// bitácora de seguimiento del personal Residente (asignado de forma fija a
// la planta de un cliente): notas que deja liderazgo al dar seguimiento
model NotaResidente {
  id          String   @id @default(cuid())
  residente   Usuario  @relation("NotaResidenteResidente", fields: [residenteId], references: [id], onDelete: Cascade)
  residenteId String
  autor       Usuario  @relation("NotaResidenteAutor", fields: [autorId], references: [id])
  autorId     String
  contenido   String
  creadoEn    DateTime @default(now())

  @@index([residenteId, creadoEn])
}

model Inspeccion {
  id                  String       @id @default(cuid())
  organizacion        Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  organizacionId      String
  nombre              String
  numeroParte         String?
  cliente             String?
  planta              String?
  meta                Int          @default(0)
  precioPorPieza      Float        @default(0)
  // "pieza" cobra piezas x precioPorPieza; "hora" cobra horas registradas x precioPorHora
  modoCobro           String       @default("pieza")
  precioPorHora       Float        @default(0)
  fechaEntrega        DateTime?
  instrucciones       String?
  instruccionesPdfUrl String?
  piezasBuenas        Int          @default(0)
  piezasMalas         Int          @default(0)
  // NG que se recuperaron con retrabajo (no se cobran aparte); scrap = malas - retrabajadas
  piezasRetrabajadas  Int          @default(0)
  cerrado             Boolean      @default(false)
  cerradoPor          String?
  cerradoEn           DateTime?
  creadoEn            DateTime     @default(now())

  // Punto Limpio: identificación del lote de material ya certificado/bueno
  // que llega de la planta del proveedor a la del cliente, con evidencia
  // fotográfica de que llegó y su confirmación (no es un check de 5S).
  puntoLimpio             String?
  puntoLimpioFotoUrl      String?
  puntoLimpioReportadoPor String?
  puntoLimpioReportadoEn  DateTime?
  puntoLimpioOk           Boolean   @default(false)
  puntoLimpioOkPor        String?
  puntoLimpioOkEn         DateTime?

  // anulación con motivo (los registros de calidad no se borran)
  anuladoEn         DateTime?
  anuladoPorId      String?
  motivoAnulacion   String?
  capturas          Captura[]
  defectos          DefectoResumen[]
  inspectores       InspeccionInspector[]
  solicitudesApoyo  SolicitudApoyo[]
  notificaciones    Notificacion[]
  enlaces           EnlaceCompartido[]
  reportes8D        Reporte8D[]
  solicitudServicio SolicitudServicio?
  asistencias       RegistroAsistencia[]
  etiquetas         EtiquetaLiberacion[]

  @@index([cliente])
  @@index([cerrado])
  @@index([organizacionId])
}

// tabla puente: qué inspectores están asignados a qué inspección
model InspeccionInspector {
  id           String     @id @default(cuid())
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspeccionId String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  usuarioId    String

  @@unique([inspeccionId, usuarioId])
  @@index([usuarioId])
}

model Captura {
  id           String     @id @default(cuid())
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspeccionId String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  usuarioId    String
  buenas       Int        @default(0)
  malas        Int        @default(0)
  retrabajadas Int        @default(0)
  defecto      String?
  fotoUrl      String?
  // id generado en el dispositivo: evita duplicados al reintentar capturas hechas sin señal
  idCliente    String?    @unique
  creadoEn     DateTime   @default(now())

  // anulación con motivo (los registros de calidad no se borran)
  anuladoEn       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?

  @@index([inspeccionId, creadoEn])
  @@index([usuarioId])
}

// contador acumulado por tipo de defecto (para el Pareto sin recalcular todo)
model DefectoResumen {
  id           String     @id @default(cuid())
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspeccionId String
  tipo         String
  cantidad     Int        @default(0)
  recuperadas  Int        @default(0)

  @@unique([inspeccionId, tipo])
}

model EstadoInspector {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String   @unique
  estado    String // activo | material | comida | bano | descanso
  estacion  String? // puesto físico de trabajo (Estación 1, 2, ...), elegido al iniciar turno
  desde     DateTime @default(now())
}

// chat grupal de liderazgo: Admin, Supervisor y Líder
model MensajeChat {
  id        String   @id @default(cuid())
  autor     Usuario  @relation(fields: [autorId], references: [id])
  autorId   String
  contenido String
  creadoEn  DateTime @default(now())

  @@index([creadoEn])
}

// llamado de un inspector pidiendo apoyo de un Líder/Supervisor en su estación
model SolicitudApoyo {
  id            String      @id @default(cuid())
  usuario       Usuario     @relation("SolicitudApoyoUsuario", fields: [usuarioId], references: [id])
  usuarioId     String
  estacion      String?
  inspeccion    Inspeccion? @relation(fields: [inspeccionId], references: [id])
  inspeccionId  String?
  atendida      Boolean     @default(false)
  atendidaPor   Usuario?    @relation("SolicitudApoyoAtendidaPor", fields: [atendidaPorId], references: [id])
  atendidaPorId String?
  atendidaEn    DateTime?
  creadoEn      DateTime    @default(now())

  @@index([atendida])
}

// notificación individual a un usuario (ej. Cliente o Líder) sobre un evento
// de una inspección, como la salida de una pieza NG
model Notificacion {
  id           String      @id @default(cuid())
  usuario      Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId    String
  inspeccion   Inspeccion? @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspeccionId String?
  tipo         String // "pieza_ng" | "solicitud_nueva" | "solicitud_respuesta" | ...
  mensaje      String
  url          String?
  leida        Boolean     @default(false)
  creadoEn     DateTime    @default(now())

  @@index([usuarioId, leida])
}

// suscripción de un navegador/dispositivo a notificaciones push (Web Push).
// Un usuario puede tener varias (distintos dispositivos).
model SuscripcionPush {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  creadoEn  DateTime @default(now())

  @@index([usuarioId])
}

// bitácora de entrega de turno: quien sale deja novedades y pendientes, con
// una foto de los números del turno, y quien entra confirma que lo recibió
model RelevoTurno {
  id            String    @id @default(cuid())
  autor         Usuario   @relation("RelevoAutor", fields: [autorId], references: [id])
  autorId       String
  turno         String // "primero" | "segundo" | "tercero"
  planta        String?
  inicioTurno   DateTime
  finTurno      DateTime
  piezasBuenas  Int       @default(0)
  piezasMalas   Int       @default(0)
  novedades     String
  pendientes    String?
  recibidoPor   Usuario?  @relation("RelevoReceptor", fields: [recibidoPorId], references: [id])
  recibidoPorId String?
  recibidoEn    DateTime?
  creadoEn      DateTime  @default(now())

  @@index([creadoEn])
  @@index([planta, creadoEn])
}

// enlace público de solo lectura a una inspección (portal del cliente sin cuenta):
// quien tenga el token ve avance, Pareto y evidencias hasta que venza o se revoque
model EnlaceCompartido {
  id           String     @id @default(cuid())
  token        String     @unique
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspeccionId String
  creadoPor    Usuario    @relation(fields: [creadoPorId], references: [id])
  creadoPorId  String
  expiraEn     DateTime?
  revocado     Boolean    @default(false)
  vistas       Int        @default(0)
  ultimaVista  DateTime?
  creadoEn     DateTime   @default(now())

  @@index([inspeccionId])
}

// reporte 8D (8 disciplinas) de contención y acción correctiva ligado a una inspección;
// puede haber varios por inspección, uno por problema/defecto
model Reporte8D {
  id               String     @id @default(cuid())
  folio            Int        @unique @default(autoincrement())
  inspeccion       Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspeccionId     String
  defecto          String?
  estado           String     @default("abierto") // abierto | cerrado
  creadoPor        Usuario    @relation(fields: [creadoPorId], references: [id])
  creadoPorId      String
  d1Equipo         String?
  d2Problema       String?
  d3Contencion     String?
  d4CausaRaiz      String?
  d5Acciones       String?
  d6Implementacion String?
  d7Prevencion     String?
  d8Cierre         String?
  cerradoEn        DateTime?
  creadoEn         DateTime   @default(now())
  actualizadoEn    DateTime   @updatedAt

  // anulación con motivo (los registros de calidad no se borran)
  anuladoEn       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?

  @@index([inspeccionId])
}

// pedido de servicio que el cliente levanta desde su portal; al aceptarse se
// convierte en una inspección
model SolicitudServicio {
  id            String      @id @default(cuid())
  folio         Int         @unique @default(autoincrement())
  cliente       String
  solicitante   Usuario     @relation("SolicitudServicioSolicitante", fields: [solicitanteId], references: [id])
  solicitanteId String
  tipo          String // sorteo | retrabajo | inspeccion_recibo | otro
  numeroParte   String
  descripcion   String
  cantidad      Int?
  planta        String?
  urgencia      String      @default("normal") // normal | urgente | critica
  fotoUrl       String?
  estado        String      @default("pendiente") // pendiente | aceptada | rechazada
  respuesta     String?
  atendidaPor   Usuario?    @relation("SolicitudServicioAtendida", fields: [atendidaPorId], references: [id])
  atendidaPorId String?
  atendidaEn    DateTime?
  inspeccion    Inspeccion? @relation(fields: [inspeccionId], references: [id], onDelete: SetNull)
  inspeccionId  String?     @unique
  creadoEn      DateTime    @default(now())

  @@index([cliente, creadoEn])
  @@index([estado])
}

// jornada de un inspector en una inspección: base para cobrar por hora y para nómina
model RegistroAsistencia {
  id           String      @id @default(cuid())
  usuario      Usuario     @relation(fields: [usuarioId], references: [id])
  usuarioId    String
  inspeccion   Inspeccion? @relation(fields: [inspeccionId], references: [id], onDelete: SetNull)
  inspeccionId String?
  entrada      DateTime    @default(now())
  salida       DateTime?
  // true cuando el sistema la cerró solo (jornada olvidada): liderazgo debe revisarla
  cerradaAuto  Boolean     @default(false)
  automatica   Boolean     @default(false)
  nota         String?
  creadoEn     DateTime    @default(now())

  // anulación con motivo (los registros de calidad no se borran)
  anuladoEn       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?

  @@index([usuarioId, entrada])
  @@index([inspeccionId, entrada])
  @@index([salida])
}

// criterio de aceptación de un número de parte con su examen; si existe, solo
// inspectores certificados en esa parte pueden asignarse a sus inspecciones
model CriterioParte {
  id             String       @id @default(cuid())
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  organizacionId String
  numeroParte    String
  descripcion    String
  fotoOkUrl      String?
  fotoNgUrl      String?
  // [{ texto, opciones: string[], correcta: number }]
  preguntas      Json         @default("[]")
  vigenciaDias   Int          @default(365)
  creadoEn       DateTime     @default(now())
  actualizadoEn  DateTime     @updatedAt

  @@unique([organizacionId, numeroParte])
}

model Certificacion {
  id            String    @id @default(cuid())
  usuario       Usuario   @relation("CertificacionInspector", fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String
  numeroParte   String
  metodo        String // examen | manual
  calificacion  Int?
  otorgadaPor   Usuario?  @relation("CertificacionOtorgante", fields: [otorgadaPorId], references: [id])
  otorgadaPorId String?
  vence         DateTime?
  creadoEn      DateTime  @default(now())

  @@unique([usuarioId, numeroParte])
  @@index([numeroParte])
}

// checklist configurable (auditoría de capas, 5S, recibo...); items: [{ texto, requiereFoto }]
model PlantillaChecklist {
  id            String      @id @default(cuid())
  nombre        String
  tipo          String // capas | 5s | recibo | producto | otro
  descripcion   String?
  items         Json        @default("[]")
  activa        Boolean     @default(true)
  creadoPor     Usuario     @relation(fields: [creadoPorId], references: [id])
  creadoPorId   String
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  auditorias    Auditoria[]
}

// una auditoría guarda copia de los items: editar la plantilla no altera auditorías pasadas
model Auditoria {
  id              String             @id @default(cuid())
  folio           Int                @unique @default(autoincrement())
  plantilla       PlantillaChecklist @relation(fields: [plantillaId], references: [id])
  plantillaId     String
  nombrePlantilla String
  tipo            String
  items           Json
  // [{ resultado: "ok" | "no" | "na" | null, comentario, fotoUrl }]
  respuestas      Json
  planta          String?
  cliente         String?
  area            String?
  auditor         Usuario            @relation(fields: [auditorId], references: [id])
  auditorId       String
  puntaje         Float?
  hallazgos       Int                @default(0)
  estado          String             @default("borrador") // borrador | completada
  creadoEn        DateTime           @default(now())
  completadaEn    DateTime?

  // anulación con motivo (los registros de calidad no se borran)
  anuladoEn       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?

  @@index([creadoEn])
  @@index([cliente])
}

// Etiqueta de "material liberado" que va pegada en cada contenedor: su QR abre
// /t/{codigo} (público) para que cualquiera en la cadena verifique qué se inspeccionó.
model EtiquetaLiberacion {
  id                String     @id @default(cuid())
  folio             Int        @unique @default(autoincrement())
  codigo            String     @unique
  inspeccion        Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspeccionId      String
  // contenedores impresos juntos comparten "tanda" para numerarlos 1 de N
  tanda             String
  contenedor        Int
  totalContenedores Int
  cantidad          Int
  lote              String?
  creadaPor         Usuario    @relation(fields: [creadaPorId], references: [id])
  creadaPorId       String
  creadoEn          DateTime   @default(now())
  anulada           Boolean    @default(false)
  anuladaEn         DateTime?
  motivoAnulacion   String?
  escaneos          Int        @default(0)
  ultimoEscaneo     DateTime?

  @@index([inspeccionId])
  @@index([tanda])
}

// Bitácora de cambios: quién hizo qué y cuándo. Solo se inserta, nunca se edita ni se borra.
model BitacoraCambio {
  id             String       @id @default(cuid())
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  organizacionId String
  usuarioId      String?
  usuarioNombre  String // copia: se conserva aunque el usuario cambie de nombre
  usuarioRol     String?
  accion         String // CREAR | EDITAR | ANULAR | ELIMINAR | CERRAR | REABRIR | DESACTIVAR | ACTIVAR
  entidad        String // Inspeccion | Captura | Auditoria | Reporte8D | Asistencia | Usuario | Criterio | Enlace
  entidadId      String
  resumen        String
  antes          Json?
  despues        Json?
  motivo         String?
  ip             String?
  creadoEn       DateTime     @default(now())

  @@index([organizacionId, creadoEn])
  @@index([entidad, entidadId])
  @@index([usuarioId])
}
