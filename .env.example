DATABASE_URL="postgresql://user:password@localhost:5432/eqs?schema=public"
NEXTAUTH_SECRET="genera-un-valor-aleatorio-largo-para-produccion"
NEXTAUTH_URL="http://localhost:3000"

# Las fotos de evidencia y los PDFs de instrucción se guardan en
# storage/uploads. En Railway, monta un Volume en esa ruta exacta
# (storage/uploads) para que persistan entre deploys.

# Notificaciones push (Web Push). Genera un par de keys UNA SOLA VEZ con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# y usa las mismas en local y en Railway (si cambian, se invalidan todas
# las suscripciones ya guardadas). NEXT_PUBLIC_VAPID_PUBLIC_KEY debe estar
# disponible también en build time (Railway la necesita antes de "npm run build").
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@tudominio.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
