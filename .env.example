DATABASE_URL="postgresql://user:password@localhost:5432/eqs?schema=public"

# Solo necesaria con un proveedor que usa connection pooler (ej. Neon).
# Prisma la usa exclusivamente para `prisma migrate deploy`.
# Local/Railway Postgres sin pooler: usa el mismo valor que DATABASE_URL.
# Neon: la misma URL que DATABASE_URL pero sin "-pooler" en el host.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/eqs?schema=public"

NEXTAUTH_SECRET="genera-un-valor-aleatorio-largo-para-produccion"
NEXTAUTH_URL="http://localhost:3000"

# Las fotos de evidencia se guardan en public/uploads. En Railway, monta un
# Volume en esa ruta exacta (public/uploads) para que persistan entre deploys.
